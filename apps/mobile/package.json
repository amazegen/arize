{
  "name": "@arize/adult-mobile-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "ios:add": "cap add ios --packagemanager SPM",
    "ios:sync": "cap sync ios",
    "ios:check": "node scripts/check-ios.mjs",
    "ios:build:simulator": "node scripts/check-ios.mjs --build"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@supabase/supabase-js": "2.106.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "^5",
    "vite": "8.3.8"
  }
}
