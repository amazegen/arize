VITE_ARIZE_EDITION=adult
VITE_NATIVE_ENABLED=false
# Public adult project settings only. Never service-role/OpenAI/Stripe keys.
VITE_ADULT_SUPABASE_URL=
VITE_ADULT_SUPABASE_PUBLISHABLE_KEY=
