NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
OPENAI_API_KEY=your-openai-api-key
NEXT_PUBLIC_FEEDBACK_URL=
# Leave false until the correct billing account, checkout, and webhooks are ready.
BILLING_ENFORCEMENT_ENABLED=false
STRIPE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=false
NEXT_PUBLIC_APP_URL=https://arize-gamma.vercel.app
ARIZE_STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_ANNUAL=price_replace_me
STRIPE_EXPECTED_MODE=test
STRIPE_EXPECTED_ACCOUNT_ID=acct_replace_me
# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Student Edition: use a SEPARATE preview project/backend, never the adult
# Production project. No checkout or adult community routes in student mode.
ARIZE_EDITION=adult
# Remains off until under-18 safety/retention, consent, and pilot QA are approved.
STUDENT_AI_ENABLED=false
# Choose a current safety-appropriate flagship after the under-18 review.
STUDENT_COACH_MODEL=
# Private, school-scoped counselor notifications. Enable only after verified
# sender, approved school consent, and a delivery test. Never NEXT_PUBLIC_.
STUDENT_COUNSELOR_NOTIFICATIONS_ENABLED=false
STUDENT_COUNSELOR_EMAIL=
STUDENT_COUNSELOR_SCHOOL_ID=
STUDENT_COUNSELOR_FROM=
RESEND_API_KEY=
# Optional, private belonging reflection. Keep off until school notice/collection
# approval. This is not attendance tracking or a school analytics dashboard.
STUDENT_BELONGING_ENABLED=false
NEXT_PUBLIC_STUDENT_AMBASSADOR_URL=
NEXT_PUBLIC_STUDENT_FEEDBACK_URL=
