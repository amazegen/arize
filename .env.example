NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
OPENAI_API_KEY=your-openai-api-key
# Reuse Curtis's existing key for THIS app only. Adult and Student deployments
# each keep their own value. The Clarity console cannot read or replace keys.
NEXT_PUBLIC_FEEDBACK_URL=
# Leave false until the correct billing account, checkout, and webhooks are ready.
BILLING_ENFORCEMENT_ENABLED=false
STRIPE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=false
NEXT_PUBLIC_APP_URL=https://arize-gamma.vercel.app
ARIZE_STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_ANNUAL=price_replace_me
STRIPE_EXPECTED_MODE=test
STRIPE_EXPECTED_ACCOUNT_ID=acct_replace_me
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me
# Server-only random signing secret, at least 32 characters. Do not reuse any provider key.
BILLING_ACCESS_SIGNING_SECRET=
# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Adult marketing only. Leave capture off until its separately approved migration
# and privacy/content review are complete. No Student keys or addresses here.
MARKETING_LEAD_CAPTURE_ENABLED=false
# Server-only random value, at least 32 characters; do not reuse a provider key.
MARKETING_RATE_LIMIT_SECRET=
# Optional notifications. Leads are saved even while these remain unconfigured.
MARKETING_NOTIFICATION_ENABLED=false
MARKETING_RESEND_API_KEY=
MARKETING_LEAD_NOTIFY_EMAIL=
# Bare address on a verified sending domain, not a display-name string.
MARKETING_LEAD_FROM_EMAIL=
# Operator-shell approval only, for a separately authorized hosted maintenance
# run. Never set true by default or to enable a scheduled job implicitly.
MARKETING_MAINTENANCE_APPROVED=false

# ADULT browser reminders. All switches remain off until a separately approved
# migration, provider/device test, privacy review and scheduler setup.
NEXT_PUBLIC_BROWSER_PUSH_ENABLED=false
BROWSER_PUSH_ENABLED=false
BROWSER_PUSH_SEND_ENABLED=false
# A dedicated Web Push VAPID pair; never reuse OpenAI, Stripe or Student keys.
NEXT_PUBLIC_BROWSER_PUSH_VAPID_PUBLIC_KEY=
BROWSER_PUSH_VAPID_PRIVATE_KEY=
BROWSER_PUSH_CONTACT=mailto:replace-with-monitored-address@example.com
# Independent server-only random secret (32+ characters). No cron is installed.
BROWSER_PUSH_DISPATCH_SECRET=

# Adult native gateway; off until a separately approved rollout. Exact origins,
# never a wildcard. Local tests use only disposable loopback services.
ARIZE_EDITION=adult
NATIVE_API_ENABLED=false
NATIVE_ALLOWED_ORIGINS=capacitor://localhost
